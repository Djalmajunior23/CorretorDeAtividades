# Variáveis Necessárias

NODE_ENV=production
PORT=8080
BACKEND_URL=http://31.97.41.64:8080
VITE_API_BASE_URL=http://31.97.41.64:8080

AI_PROVIDER=ollama
AI_MODE=local
OLLAMA_BASE_URL=http://host.docker.internal:11434

AI_ACTIVITY_MODEL=qwen2.5-coder:3b
AI_CODE_MODEL=qwen2.5-coder:3b
AI_GENERAL_MODEL=llama3.2:3b
AI_FEEDBACK_MODEL=qwen2.5-coder:3b
AI_REPORT_MODEL=phi3:mini
AI_REASONING_MODEL=deepseek-r1:8b

OCR_PROVIDER=tesseract

STORAGE_PROVIDER=local
PERSISTENT_VOLUME_PATH=/data
UPLOADS_DIR=/data/uploads
REPORTS_DIR=/data/reports
MATERIALS_DIR=/data/materials
TEMP_DIR=/data/tmp
BACKUPS_DIR=/data/backups

LOG_LEVEL=info

# Placeholders
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=

# Gestor de Competências e Observatório Pedagógico (Fase 11)
ENABLE_COMPETENCY_MANAGER=true
ENABLE_PEDAGOGICAL_OBSERVATORY=true
ENABLE_COMPETENCY_ANALYTICS=true
ENABLE_COMPETENCY_HEATMAPS=true
ENABLE_COMPETENCY_ALERTS=true
ENABLE_COMPETENCY_REPORTS=true

# Central de Avaliações, Simulados e Evidências (Fase 13)
ENABLE_ASSESSMENT_CENTER=true
ENABLE_SMART_SIMULATIONS=true
ENABLE_COMPETENCY_ASSESSMENTS=true
ENABLE_EVIDENCE_REPOSITORY=true
ENABLE_AI_EXAM_GENERATOR=true
ENABLE_AI_SIMULATION_GENERATOR=true
ENABLE_ASSESSMENT_ANALYTICS=true

# Agendamento e Exportação Periódica (S3 & Backup)
STORAGE_PROVIDER=local
PERSISTENT_VOLUME_PATH=/data
UPLOADS_DIR=/data/uploads
REPORTS_DIR=/data/reports
MATERIALS_DIR=/data/materials
TEMP_DIR=/data/tmp
BACKUPS_DIR=/data/backups
BACKUP_CRON_SCHEDULE=0 0 * * *

